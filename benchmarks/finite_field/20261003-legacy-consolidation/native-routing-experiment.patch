+// One strategy for both explicit QF_FF and field terms in unrestricted goals.
+tactic *mk_ff_tactic(ast_manager &m, params_ref const &p) {
+    if (m.proofs_enabled())
+        return and_then(mk_ff_simplify_tactic(m, p), mk_ff_smt_tactic(m, p));
+    return annotate_tactic("ff-tactic",
+        and_then(mk_ff_unique_tactic(m, p), mk_ff_simplify_tactic(m, p), mk_ff_smt_tactic(m, p)));
+}
